@model PatientMvcDetailsSPA.Models.tbl_User
@{
    ViewBag.Title = "Signup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - PatientCare Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/Site.css?v=2.0" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <div class="logo-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h2>Create Account</h2>
                <p>Join PatientCare Pro today</p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    <label for="UserName"><i class="fas fa-user" style="margin-right:6px;color:var(--text-muted);"></i> User Name</label>
                    @Html.EditorFor(m => m.UserName, new { htmlAttributes = new { @class = "form-control", placeholder = "Choose a username" } })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Password"><i class="fas fa-lock" style="margin-right:6px;color:var(--text-muted);"></i> Password</label>
                    @Html.EditorFor(m => m.Password, new { htmlAttributes = new { @class = "form-control", placeholder = "Create a password" } })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>

                <div class="form-group" style="margin-top:24px;">
                    <input type="submit" value="Create Account" class="btn btn-success btn-auth" />
                </div>
            }

            <div class="auth-footer">
                <span style="color:var(--text-muted);font-size:0.88rem;">Already have an account?</span>
                @Html.ActionLink("Sign In", "Login", "Account")
            </div>
        </div>
    </div>
</body>
</html>
