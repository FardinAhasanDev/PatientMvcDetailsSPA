@model IEnumerable<PatientMvcDetailsSPA.Models.Doctor>

@{
    ViewBag.Title = "Doctors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <h2>
        <span class="header-icon"><i class="fas fa-user-md"></i></span>
        Doctor Directory
    </h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Doctor
    </a>
</div>

<!-- Stats -->
<div class="stats-grid" style="max-width:300px;">
    <div class="stat-card">
        <div class="stat-icon primary"><i class="fas fa-stethoscope"></i></div>
        <div>
            <div class="stat-label">Total Doctors</div>
            <div class="stat-value">@Model.Count()</div>
        </div>
    </div>
</div>

<!-- Doctor Table -->
<div class="table-container">
    <div class="table-header">
        <h5><i class="fas fa-list" style="margin-right:8px;color:var(--primary);"></i> All Doctors</h5>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Doctor Name</th>
                    <th style="text-align:center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span style="display:inline-flex;align-items:center;gap:10px;">
                                <span style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--primary-light));display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.8rem;flex-shrink:0;">
                                    @item.DoctorName.Substring(0, 1).ToUpper()
                                </span>
                                <strong>@Html.DisplayFor(modelItem => item.DoctorName)</strong>
                            </span>
                        </td>
                        <td>
                            <div class="action-btns" style="justify-content:center;">
                                <a href="@Url.Action("Edit", new { id = item.DoctorId })" class="btn btn-info btn-icon btn-sm" title="Edit">
                                    <i class="fas fa-pen-to-square"></i>
                                </a>
                                <a href="@Url.Action("Details", new { id = item.DoctorId })" class="btn btn-primary btn-icon btn-sm" title="Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.DoctorId })" class="btn btn-danger btn-icon btn-sm" title="Delete">
                                    <i class="fas fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="fas fa-user-md"></i></div>
                <h5>No Doctors Found</h5>
                <p>Start by adding your first doctor.</p>
            </div>
        }
    </div>
</div>
