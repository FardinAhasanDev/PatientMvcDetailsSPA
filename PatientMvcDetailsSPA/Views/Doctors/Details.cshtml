@model PatientMvcDetailsSPA.Models.Doctor

@{
    ViewBag.Title = "Doctor Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <h2>
        <span class="header-icon"><i class="fas fa-eye"></i></span>
        Doctor Details
    </h2>
</div>

<div class="detail-card">
    <h4><i class="fas fa-user-md" style="margin-right:8px;"></i> Doctor Profile</h4>

    <dl>
        <dt>@Html.DisplayNameFor(model => model.DoctorName)</dt>
        <dd>
            <span style="display:inline-flex;align-items:center;gap:10px;">
                <span style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--primary-light));display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.85rem;">
                    @Model.DoctorName.Substring(0, 1).ToUpper()
                </span>
                @Html.DisplayFor(model => model.DoctorName)
            </span>
        </dd>
    </dl>

    <div class="action-links">
        <a href="@Url.Action("Edit", new { id = Model.DoctorId })" class="btn btn-info btn-sm">
            <i class="fas fa-pen-to-square"></i> Edit
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>
